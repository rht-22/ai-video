{
  "schema": "style_tone/v1",
  "name": "drama_clip_kr",
  "narration": {
    "tone": "recall_first_person",
    "max_cues": 5,
    "cue_len_chars": [3, 12],
    "cue_duration_sec": [1.2, 1.8],
    "fill_gaps": true,
    "relay_rule": true,
    "placement": "dialogue_gaps_only"
  },
  "labels": {
    "categories": ["state_paren", "meme_tsukkomi", "wordplay"],
    "color_map": {
      "state": "#FF9EC4",
      "comment": "#FFE24A",
      "tsukkomi": "#FF4632",
      "laugh": "#FFFFFF",
      "positive": "#7DFF9E"
    },
    "density_max": 14,
    "duration_sec": [0.6, 2.5],
    "sync_to_speech": true,
    "fill_gaps": true,
    "payoff_clean": true,
    "running_gag": true
  },
  "story": {
    "structure": "single_scene_rule_of_three",
    "title_tone": "community_meme",
    "ending": "hard_cut",
    "payoff_longtake": true,
    "hook_max_sec": 8,
    "hook_title_scene": true
  },
  "sfx": {
    "max_per_episode": 3,
    "mix_gain_db": -6,
    "target_beats": ["rage", "surprise", "action_foley"]
  },
  "subtitle": {
    "single_line": true,
    "max_line_chars": 15
  },
  "pacing": {
    "max_speech_gap_sec": 1.2,
    "gap_residual_sec": 0.4,
    "head_lead_in_sec": 1.0,
    "tail_hold_sec": 2.5,
    "min_speech_coverage": 0.55
  }
}
